{
  "name": "hammys-den",
  "type": "module",
  "version": "1.0.0",
  "main": "dist/main.js",
  "homepage": "./",
  "description": "Hammy's Den",
  "author": "fruityhamster",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "vite build && xcopy /y src\\main\\main.js dist\\",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.hammy.den",
    "productName": "Hammy's Den",
    "directories": {
      "output": "dist_electron"
    },
    "asar": false,
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/app-icon.ico"
    },
    "nsis": {
      "installerIcon": "src/renderer/assets/app-icon.ico",
      "uninstallerIcon": "src/renderer/assets/app-icon.ico",
      "uninstallDisplayName": "Hammy's Den",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "prisma": "^6.1.0",
    "vite": "^8.0.3",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.105.2",
    "@tailwindcss/vite": "^4.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "electron-reload": "^2.0.0-alpha.1",
    "i18n": "^0.15.3",
    "i18next": "^26.3.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "tailwindcss": "^4.2.2"
  }
}
