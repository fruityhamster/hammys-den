{
  "name": "hammys-den",
  "type": "module",
  "version": "1.0.0",
  "main": "./src/main/main.js",
  "homepage": "./",
  "description": "Hammy's Den",
  "author": "fruityhamster",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.hammy.den",
    "productName": "Hammy's Den",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "./src/main/main.js",
      "prisma/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "prisma": "^6.19.3",
    "vite": "^8.0.3",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.105.2",
    "@tailwindcss/vite": "^4.2.2",
    "bcryptjs": "^3.0.3",
    "electron-reload": "^2.0.0-alpha.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  }
}
